<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GlassSweeper_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GlassSweeper_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  HUD  -->
        <Border
            Grid.Row="0"
            Padding="16,10"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Mines remaining  -->
                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <TextBlock FontSize="20" Text="&#x1F6A9;" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind ViewModel.MinesRemainingText, Mode=OneWay}" />
                </StackPanel>

                <!--  Face / New Game + difficulty  -->
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="12"
                    VerticalAlignment="Center">
                    <Button
                        Width="56"
                        Height="56"
                        Padding="0"
                        Click="OnFaceClicked"
                        CornerRadius="12"
                        ToolTipService.ToolTip="New game">
                        <TextBlock FontSize="26" Text="{x:Bind ViewModel.FaceGlyph, Mode=OneWay}" />
                    </Button>
                    <DropDownButton
                        Height="40"
                        VerticalAlignment="Center"
                        CornerRadius="8">
                        <DropDownButton.Content>
                            <TextBlock Text="{x:Bind ViewModel.DifficultyLabel, Mode=OneWay}" />
                        </DropDownButton.Content>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Click="OnDifficultyEasy" Text="Easy — 9×9, 10 mines" />
                                <MenuFlyoutItem Click="OnDifficultyMedium" Text="Medium — 13×13, 25 mines" />
                                <MenuFlyoutItem Click="OnDifficultyHard" Text="Hard — 16×16, 45 mines" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Click="OnDifficultyCustom" Text="Custom…" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>

                <!--  Timer  -->
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <TextBlock FontSize="20" Text="&#x23F1;" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.TimeText, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Board + overlay  -->
        <Grid Grid.Row="1">
            <Viewbox
                MaxWidth="900"
                MaxHeight="900"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Stretch="Uniform"
                StretchDirection="Both">
                <Border
                    Padding="8"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <Grid x:Name="BoardHost" />
                </Border>
            </Viewbox>

            <!--  Game-over overlay  -->
            <Border
                x:Name="OverlayRoot"
                Padding="40,28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Visibility="{x:Bind BoolToVisibility(ViewModel.IsGameOver), Mode=OneWay}">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="34"
                        FontWeight="Bold"
                        Text="{x:Bind ViewModel.OverlayTitle, Mode=OneWay}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.OverlaySubtitle, Mode=OneWay}" />
                    <Button
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Click="OnFaceClicked"
                        Content="Play again"
                        Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
